PORT=5000
MONGO_URI=mongodb://localhost:27017/ReWear
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated origins allowed to call the API
CLIENT_URL=http://localhost:5173

# Cloudinary (Dashboard > Settings > API Keys). Approved product photos are stored here.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Photo moderation (optional tuning; models run locally, no keys needed)
# NSFW_THRESHOLD=0.9          # always reject at or above this NSFW score
# NSFW_SOFT_THRESHOLD=0.6     # above this, reject unless CLIP clearly sees clothing
# CLEAR_CLOTHING=0.7          # "clearly clothing" for the rule above
# CLIP_EXPLICIT_THRESHOLD=0.3 # second explicit-content check
# CLOTHING_THRESHOLD=0.5      # accept only if this much looks like clothing
# NSFW_MODEL=AdamCodd/vit-base-nsfw-detector
# CLIP_MODEL=Xenova/clip-vit-base-patch32
# MODEL_CACHE_DIR=C:/models/rewear  # set a short path on Windows (260-char path limit)
